{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eol-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eol-db",
      // database_id vynechané – wrangler databázu pri prvom deployi vytvorí (auto-provisioning).
      // Ak už eol-db existuje, môžeš sem doplniť "database_id": "<id>".
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (wrangler secret put …):
  //   API_TOKEN   – voliteľný Bearer token pre /mcp a /api (ak nie je nastavený, prístup je otvorený
  //                 – vhodné, ak je pred tým Cloudflare Access / MCP portál)
  //   ADMIN_TOKEN – povinný pre POST /admin/import
}
