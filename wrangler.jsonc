{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eol-agent",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eol-db",
      // po `wrangler d1 create eol-db` sem vlož skutočné ID
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (wrangler secret put …):
  //   API_TOKEN   – voliteľný Bearer token pre /mcp a /api (ak nie je nastavený, prístup je otvorený
  //                 – vhodné, ak je pred tým Cloudflare Access / MCP portál)
  //   ADMIN_TOKEN – povinný pre POST /admin/import
}
